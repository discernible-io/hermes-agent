#!/usr/bin/env python3
"""
Hermes Agent CLI launcher.

This wrapper should behave like the installed `hermes` command, including
subcommands such as `gateway`, `cron`, and `doctor`.

On this discernible fork, Podman operator verbs (start/stop/status/…) are
delegated to deploy/hermes.sh before importing hermes_cli — so they work
without a local Python venv.
"""

from __future__ import annotations

import os
import sys

# Podman deploy ops — handled by deploy/hermes.sh (no Python deps required).
_DEPLOY_COMMANDS = frozenset(
    {
        "init",
        "setup",
        "start",
        "stop",
        "status",
        "logs",
        "pull",
        "chat",
        "exec",
        "own",
        "idcp-install",
        "idcp",
        "himalaya-install",
        "himalaya-password",
        "himalaya-test",
        "generate-certs",
        "build-nginx",
    }
)


def _maybe_exec_deploy() -> None:
    if len(sys.argv) < 2:
        return
    cmd = sys.argv[1]
    if cmd not in _DEPLOY_COMMANDS:
        return
    root = os.path.dirname(os.path.abspath(__file__))
    script = os.path.join(root, "deploy", "hermes.sh")
    if not os.path.isfile(script):
        print(f"deploy wrapper missing: {script}", file=sys.stderr)
        sys.exit(1)
    os.execv(script, [script, *sys.argv[1:]])


if __name__ == "__main__":
    _maybe_exec_deploy()
    from hermes_cli.main import main

    main()
