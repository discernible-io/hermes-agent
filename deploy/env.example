# Copy to ../hermes-agent-app/env.local (chmod 600). Never commit env.local.
# These become container -e flags on start. Prefer hermes setup for interactive config.

# Official image (Podman pulls from docker.io)
HERMES_IMAGE=docker.io/nousresearch/hermes-agent:latest

# Optional: path to gennearaccount binary (defaults to PATH, then ~/gennearaccount/src/gennearaccount)
# GENNEARACCOUNT_BIN=/home/dedalo47/gennearaccount/src/gennearaccount

# IdentyClaw API (default https://api.identyclaw.com)
# IDENTYCLAW_BASE_URL=https://api.identyclaw.com

# Iron-proxy egress (off by default — hermes.sh sets proxy.enabled=false in config.yaml).
# Set to 1 only after: hermes egress setup
# HERMES_EGRESS=0

# Himalaya / Migadu email (agent mailbox — skill + CLI in app/bin)
HERMES_EMAIL=hermes@agenthood.me
HERMES_EMAIL_DISPLAY_NAME="Hermes Trimegisto"
# HERMES_MAIL_PASSWORD=          # or: ./hermes.sh himalaya-password
# HIMALAYA_VERSION=v1.2.0
# Migadu UI prefers 465/tls; Himalaya on this host hangs on 465 — use 587/start-tls.
# HERMES_SMTP_PORT=587
# HERMES_SMTP_ENCRYPTION=start-tls
# MIGADU_SMTP_IPV4=37.59.57.117  # pin smtp.migadu.com (IPv6 resets)

# Published ports (host → container).
# Telegram Bot API only accepts inbound webhooks on 443, 80, 88, or 8443 —
# repo default is 8443. Do not change these defaults for a specific host:
# override HERMES_TELEGRAM_PORT / HERMES_INGRESS_PORT in hermes-agent-app/env.local
# (this host: 10443, with infra-app REDIRECT 80→10443; OpenClaw owns 8443).
# Operator API stays on 11642.
HERMES_API_PORT=11642
HERMES_TELEGRAM_PORT=8443
# TELEGRAM_WEBHOOK_PORT=8443       # container listen (default); pod mode remaps to 8643
# TELEGRAM_WEBHOOK_URL=https://hermes.example.com:8443/telegram
# TELEGRAM_WEBHOOK_SECRET=         # required with TELEGRAM_WEBHOOK_URL (openssl rand -hex 32)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ALLOWED_USERS=
# HERMES_DASHBOARD_PORT=11919
# HERMES_DASHBOARD=1

# Deploy mode: standalone (default) or pod (nginx TLS sidecar + webhooks)
# HERMES_DEPLOY_MODE=standalone
# HERMES_DEPLOY_MODE=pod
# Required when HERMES_DEPLOY_MODE=pod:
# HERMES_PUBLIC_HOST=hermes.example.com
# HERMES_INGRESS_PORT=8443         # HTTPS for Telegram (allowed webhook port)
# WEBHOOK_SECRET=generate-a-strong-secret-here
# WEBHOOK_ENABLED=true
# WEBHOOK_PORT=8644              # pod-local Hermes webhook adapter (not published)
# HERMES_NGINX_IMAGE=localhost/hermes-nginx:local
# HERMES_POD=hermes-agent-pod
# HERMES_NGINX_CONTAINER=hermes-nginx

# Model / provider keys (pick what you use)
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# NOUS_API_KEY=
# GOOGLE_API_KEY=
# GEMINI_API_KEY=

# Optional OpenAI-compatible API server inside the gateway
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=
# API_SERVER_CORS_ORIGINS=*
